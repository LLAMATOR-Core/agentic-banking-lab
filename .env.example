# Copy to .env. Values below are deliberately local-development values.
POSTGRES_PASSWORD=postgres
MONGO_ROOT_PASSWORD=mongo
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_BANKING_AGENT_SECRET=banking-agent-secret
KEYCLOAK_BANK_MCP_SECRET=bank-mcp-secret
KEYCLOAK_BANK_MCP_VULNERABLE_SECRET=bank-mcp-vulnerable-secret
KEYCLOAK_TRAVEL_AGENT_SECRET=travel-agent-secret

# Real read-only MCP providers listed in MCP Market.
# HasData Booking MCP: https://mcp.hasdata.com/mcp?apis=booking
HASDATA_API_KEY=
BOOKING_MCP_URL=https://mcp.hasdata.com/mcp?apis=booking
# Self-hosted Aviasales MCP uses the Travelpayouts Data API.
AVIASALES_API_TOKEN=
AVIASALES_PARTNER_ID=
AVIASALES_DEFAULT_CURRENCY=rub
AVIASALES_MARKET=ru
AVIASALES_LOCALE=ru
AVIASALES_MCP_AUTH_TOKEN=local-aviasales-mcp

# Required by banking-agent, travel-agent and memory-orchestrator.
# OPENAI_BASE_URL may point to OpenAI or any compatible Chat Completions endpoint.
# For a local provider that does not validate keys, set a non-empty placeholder key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_JSON_MODE=true
OPENAI_TIMEOUT_SECONDS=45
MEMORY_HTTP_TIMEOUT_SECONDS=60
TRAVEL_HTTP_TIMEOUT_SECONDS=180
BANK_TIMEZONE=Europe/Moscow

# Langfuse local bootstrap credentials.
LANGFUSE_PUBLIC_KEY=pk-lf-local-agentic-banking
LANGFUSE_SECRET_KEY=sk-lf-local-agentic-banking
LANGFUSE_INIT_USER_PASSWORD=langfuse
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LANGFUSE_SALT=local-development-salt
LANGFUSE_NEXTAUTH_SECRET=local-development-nextauth-secret

# Set true only for isolated unit tests. Never use in a shared environment.
AUTH_DISABLED=false
