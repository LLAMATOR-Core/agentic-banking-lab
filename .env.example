# Скопируйте в .env, укажите ключ LLM и запустите:
# docker compose --env-file .env up -d --build
# Пароли ниже предназначены только для локального учебного стенда.
POSTGRES_PASSWORD=postgres
MONGO_ROOT_PASSWORD=mongo
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_BANKING_AGENT_SECRET=banking-agent-secret
KEYCLOAK_BANK_MCP_SECRET=bank-mcp-secret
KEYCLOAK_BANK_MCP_VULNERABLE_SECRET=bank-mcp-vulnerable-secret
KEYCLOAK_TRAVEL_AGENT_SECRET=travel-agent-secret
KEYCLOAK_MEMORY_OPERATOR_SECRET=memory-operator-secret

# MCP АБС: secure — клиент определяется по JWT;
# vulnerable — customer_id выбирает LLM (намеренная уязвимость).
ABS_MCP_MODE=secure

# Поиск авиабилетов: tutu — реальный поиск без API-ключа; mock — один вымышленный рейс.
# При ошибке Туту автоматического переключения на мок нет.
FLIGHTS_PROVIDER=tutu
TUTU_MCP_URL=https://mcp.tutu.ru/mcp
# Токен собственного мокового MCP.
# Мок запускается вместе со стендом и доступен для лабораторных опытов.
FLIGHTS_MCP_AUTH_TOKEN=local-flights-mcp
# Текст в ответе мока: clean.txt — нейтральная заметка;
# provider-note.txt — ложная инструкция для опыта с отравлением памяти.
# Файлы находятся в infra/flights-mcp/.
FLIGHTS_MOCK_NOTE=clean.txt

# Необязательные адреса собственных реализаций. Раскомментируйте при замене сервиса.
# ABS_MCP_URL=http://abs-mcp:8101/mcp
# ABS_MCP_VULNERABLE_URL=http://abs-mcp-vulnerable:8104/mcp
# TRAVEL_AGENT_URL=http://travel-api:8003
# MEMORY_URL=http://memory-api:8002
# MOCK_FLIGHTS_MCP_URL=http://flights-mcp:8106/mcp
# Адрес мока относится только к travel-системе; банковский агент обращается к ней по A2A.

# LLM нужна банковскому агенту, тревел-агенту и оркестратору памяти.
# OPENAI_BASE_URL должен поддерживать Chat Completions и Embeddings.
# Для локального провайдера без проверки ключей укажите непустое значение ключа.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_JSON_MODE=true
OPENAI_TIMEOUT_SECONDS=45
MEMORY_HTTP_TIMEOUT_SECONDS=60
TRAVEL_HTTP_TIMEOUT_SECONDS=180
BANK_TIMEZONE=Europe/Moscow

# Интервал обработки очереди долговременной памяти в секундах.
# 1800 — обычный режим; 10 — быстрый опыт; 0 — только ручной запуск через API.
MEMORY_ORCHESTRATION_INTERVAL_SECONDS=1800

# При необходимости укажите отдельного провайдера, ключ и модель для каждой системы.
# Пустое значение означает использование общих OPENAI_* выше.
BANKING_OPENAI_API_KEY=
BANKING_OPENAI_BASE_URL=
BANKING_OPENAI_MODEL=
TRAVEL_OPENAI_API_KEY=
TRAVEL_OPENAI_BASE_URL=
TRAVEL_OPENAI_MODEL=
MEMORY_OPENAI_API_KEY=
MEMORY_OPENAI_BASE_URL=
MEMORY_OPENAI_MODEL=

# Доступ Langfuse к S3-хранилищу SeaweedFS.
SEAWEEDFS_ACCESS_KEY=langfuse
SEAWEEDFS_SECRET_KEY=local-seaweedfs-secret

# Ключи и учётная запись Langfuse при первом запуске.
# Три разных проекта и пары ключей. Контейнер каждой системы получает только свою пару.
BANKING_LANGFUSE_PUBLIC_KEY=pk-lf-banking
BANKING_LANGFUSE_SECRET_KEY=sk-lf-local-banking
TRAVEL_LANGFUSE_PUBLIC_KEY=pk-lf-travel
TRAVEL_LANGFUSE_SECRET_KEY=sk-lf-local-travel
MEMORY_LANGFUSE_PUBLIC_KEY=pk-lf-memory
MEMORY_LANGFUSE_SECRET_KEY=sk-lf-local-memory
LANGFUSE_INIT_USER_PASSWORD=langfuse
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LANGFUSE_SALT=local-development-salt
LANGFUSE_NEXTAUTH_SECRET=local-development-nextauth-secret

# Отключайте проверку JWT только в изолированных автоматических тестах.
AUTH_DISABLED=false
